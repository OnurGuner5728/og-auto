<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/txt_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="@string/status_idle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:text="@string/steps_title" />

    <LinearLayout
        android:id="@+id/steps_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="@string/step_start" />

    <Button
        android:id="@+id/btn_capture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_capture" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textStyle="bold"
        android:text="@string/webtv_section" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:text="@string/webtv_help" />

    <EditText
        android:id="@+id/edit_webtv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/webtv_hint"
        android:inputType="textUri"
        android:singleLine="true" />

    <Button
        android:id="@+id/btn_webtv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_webtv" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textStyle="bold"
        android:text="@string/video_section" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:text="@string/video_section_help" />

    <EditText
        android:id="@+id/edit_playlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/video_playlist_hint"
        android:inputType="textUri"
        android:singleLine="true" />

    <Button
        android:id="@+id/btn_playlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_playlist" />

    <TextView
        android:id="@+id/txt_playlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/browser_section" />

    <EditText
        android:id="@+id/edit_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_hint"
        android:imeOptions="actionGo"
        android:inputType="textUri"
        android:singleLine="true" />

    <Button
        android:id="@+id/btn_open_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_open_in_car" />

    <Button
        android:id="@+id/btn_play_in_car"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_play_in_car" />

    <Button
        android:id="@+id/btn_bookmarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_bookmarks" />

    <Button
        android:id="@+id/btn_patreon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/btn_patreon" />

    <Button
        android:id="@+id/btn_support"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_support" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="13sp"
        android:text="@string/setup_footer" />

</LinearLayout>
</ScrollView>
